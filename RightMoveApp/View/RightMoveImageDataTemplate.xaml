<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModel="clr-namespace:RightMove.Desktop.View"
                    xmlns:userControls="clr-namespace:RightMove.Desktop.UserControls">
    
    <DataTemplate x:Key="RightMoveImageDataTemplate" DataType="{x:Type viewModel:RightMoveImageViewModel}">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" 
                   Source="{Binding Path=Image}"
                   Stretch="Uniform"
                   MinHeight="100"/>
            <userControls:BusySpinner Grid.Row="0"
                                      Visibility="{Binding Path=LoadingImage, 
                Converter={StaticResource BooleanToVisibilityConverter},
                Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" HorizontalAlignment="Center"
                       Text="{Binding ImageIndexView}"/>
            <Grid Grid.Row="2" HorizontalAlignment="Stretch">
                <Grid.Resources>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button}">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#2196F3"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="← Previous" 
                        Command="{Binding PrevImageCommand}"/>
                <Button Grid.Column="2"
                        Content="Next →" 
                        Command="{Binding NextImageCommand}"/>
            </Grid>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>