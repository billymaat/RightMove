<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModel="clr-namespace:RightMove.Desktop.ViewModel"
                    xmlns:userControls="clr-namespace:RightMove.Desktop.UserControls"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:behaviours="clr-namespace:RightMove.Desktop.Behaviours">
    
    <DataTemplate x:Key="PropertyInfoDataTemplate" DataType="{x:Type viewModel:PropertyInfoViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" ContentTemplate="{StaticResource RightMoveImageDataTemplate}"
                           Content="{Binding RightMoveImageViewModel}"/>
            
            <!--the description-->
            <userControls:BusySpinner Grid.Row="1" Visibility="{Binding IsLoadingDescription,
                Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap"/>

            <!--the nearby sold prices-->
            <userControls:BusySpinner Grid.Row="2" Visibility="{Binding IsLoadingNearbySoldPrices,
                Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ListView Grid.Row="2" Visibility="{Binding IsLoadingNearbySoldPrices, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                      ItemsSource="{Binding NearbySoldProperties}"
                      SelectedItem="{Binding SelectedNearbySoldProperty}"
                      behaviours:ListViewItemDoubleClickBehavior.Command="{Binding OpenLink}"
                      behaviours:GridViewSortBehavior.EnableSorting="True"
                      >
                <!--<b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseDoubleClick">
                        <b:InvokeCommandAction Command="{Binding OpenLink}" 
                                               CommandParameter="{Binding SelectedNearbySoldProperty}" 
                                               PassEventArgsToCommand="True" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>-->
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="200">
                            <GridViewColumnHeader Content="Address" Tag="Address"/>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Address"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumnHeader Content="Price" Tag="Price"/>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Price"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumnHeader Content="Bedrooms" Tag="Bedrooms"/>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Bedrooms"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumnHeader Content="Bathrooms" Tag="Bathrooms"/>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Bathrooms"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                        <GridViewColumn Width="120">
                            <GridViewColumnHeader Content="Date Sold" Tag="DateSold"/>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="DateSold" StringFormat="dd-MM-yyyy"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>